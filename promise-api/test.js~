// testing code for async tasks using promises

let promise = new Promise((resolve,reject)=>
    {
	setTimeout(()=>{},5000);
	let a = 1 + 1;
	if(a==2)
	{
	    resolve('Success!');
	}
	else
	{
	    reject('Failure');
	}
    }
);

console.log(promise);// Pending 
setTimeout(()=>{},4000);
console.log(promise);// Success
